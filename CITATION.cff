      - family-names: Perez
        given-names: Luis
      - family-names: Montgomerie
        given-names: Robert
    year: 2021
    journal: "From the Editor's Desk of The American Naturalist"
    url: "http://comments.amnat.org/2021/12/guidelines-for-archiving-code-with-data.html"
